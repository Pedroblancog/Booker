// Copia este archivo como Secrets.xcconfig (en esta misma carpeta) y rellénalo.
// Secrets.xcconfig está en .gitignore.

// URL del Worker desplegado (la que muestra `npx wrangler deploy`).
BOOKER_BACKEND_URL = https:/$()/booker.TU-SUBDOMINIO.workers.dev
// Descomenta para usar también el Worker desplegado en Debug (por ejemplo, en tu iPhone):
// BOOKER_BACKEND_URL[config=Debug] = https:/$()/booker.TU-SUBDOMINIO.workers.dev

// El mismo valor que el secreto APP_TOKEN del Worker (opcional).
BOOKER_BACKEND_TOKEN =
